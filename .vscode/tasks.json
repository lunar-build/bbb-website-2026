{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "docker:start",
			"type": "shell",
			"command": "docker desktop start"
		},
		{
			"label": "ddev:start",
			"type": "shell",
			"command": "ddev start",
			"options": {
				"cwd": "${workspaceFolder}/site"
			}
		},
		{
			"label": "ssh:site",
			"type": "shell",
			"command": "ddev ssh",
			"presentation": {
				"group": "ssh"
			},
			"options": {
				"cwd": "${workspaceFolder}/site"
			},
			"problemMatcher": []
		},
		{
			"label": "npm:dev",
			"type": "shell",
			"command": "ddev exec -d /var/www/html/web/app/themes/sage npm run dev",
			"isBackground": true,
			"presentation": {
				"group": "ssh"
			},
			"options": {
				"cwd": "${workspaceFolder}/site"
			},
			"problemMatcher": []
		},
		{
			"label": "ssh:panels",
			"type": "shell",
			"dependsOn": [
				"ssh:site",
				"npm:dev"
			],
			"dependsOrder": "parallel",
			"options": {
				"cwd": "${workspaceFolder}/site"
			}
		},
		{
			"label": "start-up",
			"dependsOn": [
				"docker:start",
				"ddev:start",
				"ssh:panels"
			],
			"dependsOrder": "sequence",
			"runOptions": {
				"runOn": "folderOpen"
			},
			"problemMatcher": []
		}
	]
}
